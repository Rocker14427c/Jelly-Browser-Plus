     SPDX-License-Identifier: Apache-2.0

     Splash window background: the same deep-purple gradient as the wordmark
     banner (identical palette) with the jelly banner centered, so the launch
     screen appears instantly and blends seamlessly into the animated splash.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#100D24"
                android:startColor="#241A4E" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:left="40dp"
        android:right="40dp">
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
