<?xml version="1.0" encoding="utf-8"?>
<!--
     SPDX-FileCopyrightText: 2026 Browser+
     SPDX-License-Identifier: Apache-2.0

     Inter — the open-source typeface that closely matches Apple's SF Pro
     (licensed under the SIL Open Font License, see OFL.txt). Shipped as a
     variable font with four registered weights so the whole interface —
     including textStyle="bold" in layouts — renders in it automatically.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        app:font="@font/inter_var"
        android:fontWeight="400" />
    <font
        app:font="@font/inter_var"
        android:fontVariationSettings="'wght' 500"
        android:fontWeight="500" />
    <font
        app:font="@font/inter_var"
        android:fontVariationSettings="'wght' 600"
        android:fontWeight="600" />
    <font
        app:font="@font/inter_var"
        android:fontVariationSettings="'wght' 700"
        android:fontWeight="700" />
</font-family>
