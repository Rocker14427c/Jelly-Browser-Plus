     iOS-style action sheet shown on long-pressing a download:
     Rename / Copy download link / Delete (red) / Cancel.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="24dp"
    tools:ignore="UseCompoundDrawables">

    <TextView
        android:id="@+id/downloadSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:maxLines="1"
        android:padding="16dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/downloadSheetRename"
        style="@style/Theme.Jelly.BottomSheetLayout">

        <ImageView
            style="@style/Theme.Jelly.BottomSheetIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_edit_24dp" />

        <TextView
            style="@style/Theme.Jelly.BottomSheetText"
            android:text="@string/download_action_rename" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/downloadSheetCopy"
        style="@style/Theme.Jelly.BottomSheetLayout">

        <ImageView
            style="@style/Theme.Jelly.BottomSheetIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_content_copy" />

        <TextView
            style="@style/Theme.Jelly.BottomSheetText"
            android:text="@string/download_action_copy_link" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/downloadSheetDelete"
        style="@style/Theme.Jelly.BottomSheetLayout">

        <ImageView
            style="@style/Theme.Jelly.BottomSheetIcon"
            android:contentDescription="@null"
            android:src="@drawable/ic_delete_action"
            android:tint="@color/colorDelete" />

        <TextView
            style="@style/Theme.Jelly.BottomSheetText"
            android:text="@string/download_action_delete"
            android:textColor="@color/colorDelete" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/downloadSheetCancel"
        style="@style/Theme.Jelly.BottomSheetLayout">

        <TextView
            style="@style/Theme.Jelly.BottomSheetText"
            android:text="@android:string/cancel" />
    </LinearLayout>

</LinearLayout>
